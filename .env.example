# ─── Velora · variables de entorno ───────────────────────────────────────────
# Sin ninguna variable, Velora funciona en modo demo (datos en memoria,
# motor de reglas en español y contraseña "velora2026").

# Sesiones (opcional: si no se define, se deriva de DATABASE_URL)
AUTH_SECRET=               # cadena aleatoria larga (openssl rand -base64 32)

# Iniciar sesión con Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web")
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de datos (Neon / Vercel Postgres). Sin esto, los datos viven en memoria.
DATABASE_URL=

# IA conversacional (Claude). Sin esto se usa el motor de reglas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# AI_MODE=rules            # fuerza el motor de reglas

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=            # token de sistema de la app de Meta de IONEX
WHATSAPP_PHONE_NUMBER_ID=  # número por defecto (cada negocio pone el suyo en Ajustes)
WHATSAPP_DEFAULT_BUSINESS_ID=  # negocio que recibe mensajes de números sin dueño (por defecto: demo)
WHATSAPP_VERIFY_TOKEN=     # el mismo valor que pongas en Meta al registrar el webhook
WHATSAPP_APP_SECRET=       # valida la firma X-Hub-Signature-256
WHATSAPP_REMINDER_TEMPLATE=  # plantilla aprobada con 4 variables: nombre, servicio, día, hora
# WHATSAPP_API_VERSION=v23.0

# Llamadas (Twilio Programmable Voice)
TWILIO_AUTH_TOKEN=
# VOICE_LANGUAGE=es-MX
# VOICE_NAME=Polly.Mia

# Recordatorios (Vercel Cron envía Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=
